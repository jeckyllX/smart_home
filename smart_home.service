[Unit]
Description=Smart Home Climate Automation Daemon
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/smarthome daemon
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
